\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Task B: compounding error under autoregressive rollout (log--log). One-step-trained models (solid) win at $h{=}1$ but are overtaken by persistence beyond $\sim $0.4\,s; the multi-step-consistency variant GRU-WM-MS (dotted) cuts $h{=}40$ error by 23\% and beats persistence. RSSM's stochastic prior accumulates variance and diverges ($11.4\times $ growth).}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:rollout}{{2}{3}{Task B: compounding error under autoregressive rollout (log--log). One-step-trained models (solid) win at $h{=}1$ but are overtaken by persistence beyond $\sim $0.4\,s; the multi-step-consistency variant GRU-WM-MS (dotted) cuts $h{=}40$ error by 23\% and beats persistence. RSSM's stochastic prior accumulates variance and diverges ($11.4\times $ growth)}{figure.2}{}}
